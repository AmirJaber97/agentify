# ── Agentify BFF configuration ────────────────────────────────────────────
# The BFF always binds to 127.0.0.1 (not configurable). Expose it only
# through your existing HTTPS reverse proxy.

BFF_PORT=8787

# Upstream Personal Agent OS (localhost-only service)
PAOS_BASE_URL=http://127.0.0.1:8765

# PAOS bearer token — SERVER-SIDE SECRET. Prefer the file form.
PAOS_TOKEN_FILE=/home/ajhosts/.hermes/personal_agent_os/.api_token
# PAOS_TOKEN=

# Dashboard login password (required unless MOCK_MODE=1, where it defaults to "dev")
DASHBOARD_PASSWORD=

# Session cookie signing secret: `openssl rand -hex 32`
SESSION_SECRET=

# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# Set to 1 in production behind HTTPS so the cookie is Secure
COOKIE_SECURE=1

# Development only: serve realistic fixtures instead of proxying to PAOS.
# The server refuses to start with MOCK_MODE=1 when NODE_ENV=production.
# MOCK_MODE=1
